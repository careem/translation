{
    "name": "careem/laravel-multilingual",
    "description": "A Translation package for Laravel 5 with database and cache support",
    "keywords": [
        "laravel-translator",
        "laravel",
        "translator",
        "translation",
        "localization"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "careem",
            "email": "aneel.kumar@careem.com",
            "homepage": "https://careem.com"
        }
    ],
    "require": {
        "laravel/framework": "^13.0",
        "doctrine/dbal": "^4.5",
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "orchestra/testbench": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Waavi\\Translation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waavi\\Translation\\Test\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "prefer-stable": true
}
